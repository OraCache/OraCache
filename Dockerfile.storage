# syntax=docker/dockerfile:1
FROM golang:1.27.3-alpine AS build
WORKDIR /src
ENV GOWORK=off
COPY go.mod go.sum ./
COPY gen/go.mod gen/go.sum ./gen/
RUN go mod download
COPY gen/gateway ./gen/gateway
COPY cmd/storage-node ./cmd/storage-node
COPY internal/node ./internal/node
COPY internal/store ./internal/store
COPY shardraft ./shardraft
RUN CGO_ENABLED=0 go build -trimpath -o /storage-node ./cmd/storage-node

FROM scratch
COPY --from=build /storage-node /storage-node
USER 65532:65532
ENTRYPOINT ["/storage-node"]
